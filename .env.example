# aihc-job -- everything that differs per user lives here.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# Read automatically from the repo root (override with --env-file or $AIHC_ENV_FILE).
# A real exported variable wins over this file, so `AIHC_QUEUE=x aihc-job submit` still
# works for a one-off. `aihc-job config show` prints what was picked up.
#
# .env is gitignored. chmod 600 it: this tree sits on a shared filesystem, so the
# directory is readable by others even when the file is not.

# ---------------------------------------------------------------- credentials
# Yours, not a colleague's -- job ownership and audit trails follow the key.
# Console: 用户中心 -> 安全认证 -> Access Key.
AIHC_AK=
AIHC_SK=
AIHC_REGION=cn-bj

# --------------------------------------------------------- pool and queues
# Same for everyone in this tenant; change only for a different account.
#   AIHC_POOL       the sentinel job actions require, NOT the real pool ID
#   AIHC_QUEUE_POOL the real pool ID, which only DescribeQueues accepts.
#                   Leave it empty and capacity checks plus auto-queue silently switch off.
#   AIHC_QUEUE      where jobs land by default. Pick the queue for the hardware you use;
#                   if a job does not fit, auto-queue moves it to one that does, even
#                   across chips. `aihc-job -p $AIHC_QUEUE_POOL queues` lists them:
#                     aihcq-xxxxxxxxxxxx  A800  24 cards
#                     aihcq-yyyyyyyyyyyy  A800  80
#                     aihcq-zzzzzzzzzzzz  A800  112
#                     aihcq-wwwwwwwwwwww  4090  24
#                     aihcq-vvvvvvvvvvvv  B200  8
AIHC_POOL=aihc-serverless
AIHC_QUEUE_POOL=aihc-xxxxxxxxxxxx
AIHC_QUEUE=aihcq-xxxxxxxxxxxx

# ------------------------------------------------------- template variables
# Substituted into {{...}} placeholders in examples/*.json. Braces, not $VAR, so that
# $RANK / ${MASTER_ADDR} in a launch command still reach the remote shell untouched.
#
# AIHC_IMAGE: tags in this registry accumulate a _<user>_<timestamp> suffix on every
# commit, so read your current one instead of copying someone else's:
#   aihc-job raw DescribeDevInstances --method GET --no-pool --query pageSize=100
AIHC_IMAGE=ccr-xxxxxxxx-vpc.cnc.bj.baidubce.com/gpu/<your-image>:<tag>

# Your directory on the shared CFS. Mounted at the same path inside the container, so
# a command that runs locally runs unchanged on AIHC.
AIHC_WORKDIR=/share/<your-unix-dir>

# Goes on every job as the `owner` label; usually your AIHC username, which is not
# necessarily your unix directory name.
AIHC_OWNER=<your-aihc-username>

# ------------------------------------------------------------- shared /share
# The CFS instance behind /share, from `mount | grep /share`. Both fields are required
# by CreateJob even though DescribeJob reads them back blank.
AIHC_CFS_INSTANCE=cfs-xxxxxxxx
AIHC_CFS_MOUNT=cfs-xxxxxxxx.lb-yyyyyyyy.cfs.bj.baidubce.com

# ------------------------------------------------------------------ optional
# AIHC_TIMEOUT=60      per-request HTTP timeout, seconds
# AIHC_RETRIES=3       retries on 429/5xx
# AIHC_ENDPOINT=       override the regional OpenAPI host
